{
  "version": 1,
  "tests": [
    {
      "id": "unit",
      "suites": [
        "unit"
      ],
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/unit",
        "-v"
      ],
      "timeout_seconds": 180,
      "sanitize": false,
      "release": true
    },
    {
      "id": "misc",
      "suites": [
        "regression"
      ],
      "command": [
        "{python}",
        "tests/regression/check_misc.py"
      ],
      "timeout_seconds": 180,
      "sanitize": false,
      "release": true
    },
    {
      "id": "keys",
      "suites": [
        "regression"
      ],
      "command": [
        "{python}",
        "tests/regression/check_keys.py"
      ],
      "timeout_seconds": 180,
      "sanitize": false,
      "release": true
    },
    {
      "id": "navigation",
      "suites": [
        "regression"
      ],
      "command": [
        "{python}",
        "tests/regression/check_navigation.py"
      ],
      "timeout_seconds": 180,
      "sanitize": false,
      "release": true
    },
    {
      "id": "ignores",
      "suites": [
        "regression"
      ],
      "command": [
        "{python}",
        "tests/regression/check_ignores.py"
      ],
      "timeout_seconds": 180,
      "sanitize": false,
      "release": true
    }
  ]
}
